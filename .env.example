# ============================================================================
#  Transcriber — единый файл конфигурации. Скопируйте: cp .env.example .env
# ============================================================================

# --- Общее ------------------------------------------------------------------
TZ=Europe/Moscow
# Публичный адрес фронтенда (для CORS и ссылок). На VPS: https://transcriber.example.com
PUBLIC_BASE_URL=http://localhost:8080
# Список origin через запятую, которым разрешён доступ к API
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# --- Порты на хосте ---------------------------------------------------------
FRONTEND_PORT=8080
API_PORT=8000
ASR_PORT=8001
N8N_PORT=5678
OLLAMA_PORT=11434

# --- API (backend) ----------------------------------------------------------
# Ключ, который фронтенд шлёт в заголовке X-API-Key. Пустое значение = без авторизации.
API_KEY=
# Максимальный размер загружаемого файла, МБ
MAX_UPLOAD_MB=1024
# Сколько часов хранить результаты и исходники
RETENTION_HOURS=24
# Режим конвейера: direct | n8n
#   direct — backend сам вызывает ASR -> LLM -> доставку
#   n8n    — backend отдаёт файл в n8n webhook, вся логика в workflow
PIPELINE_MODE=direct

# --- ASR (Speaches / faster-whisper, OpenAI-совместимый API) ----------------
ASR_BASE_URL=http://asr:8000/v1
ASR_API_KEY=
# Модели: Systran/faster-whisper-small | Systran/faster-whisper-large-v3
#         deepdml/faster-whisper-large-v3-turbo-ct2 (быстрая, хороша для RU)
WHISPER__MODEL=Systran/faster-whisper-small
WHISPER__COMPUTE_TYPE=int8
WHISPER__INFERENCE_DEVICE=cpu
# Держать модель в памяти (-1 = не выгружать)
STT_MODEL_TTL=-1
# Подсказка Whisper по умолчанию (initial_prompt, до 224 токенов), если в задаче не задана своя.
# Пишите связным текстом с пунктуацией — Whisper подхватывает и термины, и стиль (запятые, точки).
# Пример: ASR_PROMPT=Интервью системного аналитика. Обсуждаем REST API, POST, PUT, PATCH, идемпотентность, Kafka, Redis, outbox, PlantUML, BPMN.
ASR_PROMPT=
# Расширения faster-whisper (Speaches), не входят в контракт OpenAI.
# Для облачного OpenAI/Groq: ASR_VAD_FILTER=false и пустой ASR_HOTWORDS.
# VAD отсекает тишину — меньше галлюцинаций на паузах (в Speaches по умолчанию выключен)
ASR_VAD_FILTER=true
# Слова, которые Whisper должен «ожидать» услышать (через пробел).
# Не сочетайте с ASR_PROMPT: вместе они провоцируют зацикливание (проверено на large-v3-turbo)
ASR_HOTWORDS=
# Длинная запись режется по паузам на куски ~N секунд и распознаётся независимо:
# зацикливание Whisper не выходит за пределы куска. 0 = отправлять файл целиком
ASR_CHUNK_SECONDS=600
# Порог зацикливания (коэффициент сжатия текста). Выше — кусок перераспознаётся
ASR_LOOP_THRESHOLD=4.0

# --- LLM (постобработка: суммаризация, протокол, перевод) -------------------
# Любой OpenAI-совместимый endpoint: Ollama, vLLM, LM Studio, OpenAI, OpenRouter
LLM_BASE_URL=http://ollama:11434/v1
LLM_API_KEY=ollama
LLM_MODEL=qwen2.5:7b-instruct
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
# Кусок текста на один запрос постобработки, символов (~1 000 символов ≈ 1 минута речи)
LLM_CHUNK_CHARS=12000
# Окно контекста Ollama, токенов. Должно вмещать кусок + ответ (12 000 символов RU ≈ 5 000 токенов)
OLLAMA_CONTEXT_LENGTH=16384

# --- Нормализация расшифровки (LLM: пунктуация + термины по глоссарию) ------
# Включена для всех задач, если в options не передано "normalize": false
NORMALIZE_DEFAULT=true
# Размер пачки сегментов на один запрос, символов. Меньше — надёжнее для 7B-моделей
NORMALIZE_CHUNK_CHARS=2500
# Свой глоссарий (путь внутри контейнера). Пусто = встроенный backend/app/glossary.txt
GLOSSARY_FILE=

# --- Telegram ---------------------------------------------------------------
# @BotFather -> /newbot
TELEGRAM_BOT_TOKEN=
# ID чата по умолчанию (узнать: /docs/05-telegram-bot.md)
TELEGRAM_CHAT_ID=

# --- Внешний webhook (произвольная «ручка») ---------------------------------
OUTBOUND_WEBHOOK_URL=
OUTBOUND_WEBHOOK_TOKEN=

# --- n8n --------------------------------------------------------------------
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me
GENERIC_TIMEZONE=Europe/Moscow
# Куда backend шлёт задание в режиме PIPELINE_MODE=n8n
N8N_WEBHOOK_URL=http://n8n:5678/webhook/transcriber
N8N_WEBHOOK_TOKEN=change-me-shared-secret

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
