# ============================================================================
#  Transcriber — единый файл конфигурации. Скопируйте: cp .env.example .env
# ============================================================================

# --- Общее ------------------------------------------------------------------
TZ=Europe/Moscow
# Публичный адрес фронтенда (для CORS и ссылок). На VPS: https://transcriber.example.com
PUBLIC_BASE_URL=http://localhost:8080
# Список origin через запятую, которым разрешён доступ к API
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# --- Порты на хосте ---------------------------------------------------------
FRONTEND_PORT=8080
API_PORT=8000
ASR_PORT=8001
N8N_PORT=5678
OLLAMA_PORT=11434

# --- API (backend) ----------------------------------------------------------
# Ключ, который фронтенд шлёт в заголовке X-API-Key. Пустое значение = без авторизации.
API_KEY=
# Максимальный размер загружаемого файла, МБ
MAX_UPLOAD_MB=1024
# Сколько часов хранить результаты и исходники
RETENTION_HOURS=24
# Режим конвейера: direct | n8n
#   direct — backend сам вызывает ASR -> LLM -> доставку
#   n8n    — backend отдаёт файл в n8n webhook, вся логика в workflow
# Это значение по умолчанию. Переключать без перезапуска можно на странице /admin
# (или PUT /api/v1/admin/pipeline-mode): режим читается при создании каждой задачи
PIPELINE_MODE=direct

# --- ASR (Speaches / faster-whisper, OpenAI-совместимый API) ----------------
ASR_BASE_URL=http://asr:8000/v1
ASR_API_KEY=
# Модели: Systran/faster-whisper-small | Systran/faster-whisper-large-v3
#         deepdml/faster-whisper-large-v3-turbo-ct2 (быстрая, хороша для RU)
WHISPER__MODEL=Systran/faster-whisper-small
WHISPER__COMPUTE_TYPE=int8
WHISPER__INFERENCE_DEVICE=cpu
# Держать модель в памяти (-1 = не выгружать)
STT_MODEL_TTL=-1
# Подсказка Whisper по умолчанию (initial_prompt, до 224 токенов), если в задаче не задана своя.
# Пишите связным текстом с пунктуацией — Whisper подхватывает и термины, и стиль (запятые, точки).
# Пример: ASR_PROMPT=Интервью системного аналитика. Обсуждаем REST API, POST, PUT, PATCH, идемпотентность, Kafka, Redis, outbox, PlantUML, BPMN.
ASR_PROMPT=
# Расширения faster-whisper (Speaches), не входят в контракт OpenAI.
# Для облачного OpenAI/Groq: ASR_VAD_FILTER=false и пустой ASR_HOTWORDS.
# VAD отсекает тишину — меньше галлюцинаций на паузах (в Speaches по умолчанию выключен)
ASR_VAD_FILTER=true
# Слова, которые Whisper должен «ожидать» услышать (через пробел).
# Не сочетайте с ASR_PROMPT: вместе они провоцируют зацикливание (проверено на large-v3-turbo)
ASR_HOTWORDS=
# Длинная запись режется по паузам на куски ~N секунд и распознаётся независимо:
# зацикливание Whisper не выходит за пределы куска. 0 = отправлять файл целиком
ASR_CHUNK_SECONDS=600
# Порог зацикливания (коэффициент сжатия текста). Выше — кусок перераспознаётся
ASR_LOOP_THRESHOLD=4.0
# Вырезать типовые галлюцинации Whisper на тишине: «Редактор субтитров А.Семкин»,
# «Субтитры сделал DimaTorzok», «Продолжение следует…». Опустевший сегмент удаляется
ASR_HALLUCINATION_FILTER=true
# Свой файл с шаблонами (регулярка на строку, # — комментарий) дополняет встроенный список
ASR_HALLUCINATION_FILE=
# Петля из короткой фразы (1–4 слова), повторённой подряд не меньше N раз, в том числе через
# границы сегментов («REST API, REST API, …» ×29), схлопывается до ASR_REPEAT_KEEP повторов.
# «да, да, да» (×3) не трогается. 0 = выключить
ASR_REPEAT_THRESHOLD=4
ASR_REPEAT_KEEP=1

# --- LLM (постобработка: суммаризация, протокол, перевод) -------------------
# Любой OpenAI-совместимый endpoint: Ollama, vLLM, LM Studio, OpenAI, OpenRouter
LLM_BASE_URL=http://ollama:11434/v1
LLM_API_KEY=ollama
# VPS / первичный запуск: gemma3:12b. Локально с мощным GPU — gemma4:26b из Ollama на хосте
# (LLM_BASE_URL=http://host.docker.internal:11434/v1)
LLM_MODEL=gemma3:12b
LLM_TEMPERATURE=0.2
LLM_MAX_TOKENS=2048
# «Думающие» модели (gemma4, qwen3) тратят лимит токенов на рассуждения и отдают пустой ответ —
# нормализация молча пропускается. Для них: none. Для остальных оставьте пустым
LLM_REASONING_EFFORT=
# Кусок текста на один запрос постобработки, символов (~1 000 символов ≈ 1 минута речи)
LLM_CHUNK_CHARS=12000
# Окно контекста Ollama, токенов. Должно вмещать кусок + ответ (12 000 символов RU ≈ 5 000 токенов)
OLLAMA_CONTEXT_LENGTH=16384

# --- Нормализация расшифровки (LLM: пунктуация + термины по глоссарию) ------
# Включена для всех задач, если в options не передано "normalize": false
NORMALIZE_DEFAULT=true
# Размер пачки сегментов на один запрос, символов. Крупнее — меньше запросов и больше
# контекста для терминов; потерянные строки модели всё равно остаются исходными.
# Вход+выход пачки должны влезть в контекст (8000 символов ≈ 7–8k токенов из 16k)
NORMALIZE_CHUNK_CHARS=8000
# Потолок токенов ответа на пачку. 0 = считать от размера пачки
NORMALIZE_MAX_TOKENS=0
# Свой глоссарий (путь внутри контейнера). Пусто = встроенный backend/app/glossary.txt
GLOSSARY_FILE=

# --- Диаризация (разделение по говорящим) -----------------------------------
# Сервис diarizer (sherpa-onnx, CPU). Пустой адрес = диаризация выключена
DIARIZE_BASE_URL=http://diarizer:8000
# Включена по умолчанию (в UI и API можно отключить для конкретной задачи)
DIARIZE_DEFAULT=true
DIARIZER_THREADS=4
# Порог кластеризации: выше — меньше говорящих, ниже — больше. Число говорящих можно задать в UI
DIARIZER_THRESHOLD=0.5

# --- Telegram ---------------------------------------------------------------
# @BotFather -> /newbot
TELEGRAM_BOT_TOKEN=
# ID чата по умолчанию (узнать: /docs/05-telegram-bot.md)
TELEGRAM_CHAT_ID=

# --- Внешний webhook (произвольная «ручка») ---------------------------------
OUTBOUND_WEBHOOK_URL=
OUTBOUND_WEBHOOK_TOKEN=

# --- n8n --------------------------------------------------------------------
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
N8N_ENCRYPTION_KEY=change-me-to-a-long-random-string
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=change-me
GENERIC_TIMEZONE=Europe/Moscow
# Куда backend шлёт задание в режиме PIPELINE_MODE=n8n
N8N_WEBHOOK_URL=http://n8n:5678/webhook/transcriber
N8N_WEBHOOK_TOKEN=change-me-shared-secret

# --- Prod / вход через oauth2-proxy (docker-compose.prod.yml) ----------------
# Адрес Caddy: на VPS — домен, локально — ":80" (http без TLS)
SITE_ADDRESS=transcriber.example.com
ACME_EMAIL=admin@example.com
# Порты Caddy на хосте. Локально, например: 8081 (80 может быть занят)
CADDY_HTTP_PORT=80
CADDY_HTTPS_PORT=443
# Провайдер: google | github | oidc | ... (https://oauth2-proxy.github.io/oauth2-proxy/configuration/providers)
OAUTH2_PROXY_PROVIDER=google
OAUTH2_PROXY_CLIENT_ID=
OAUTH2_PROXY_CLIENT_SECRET=
# openssl rand -base64 24 | tr -- '+/' '-_'  (ровно 16/24/32 байта)
OAUTH2_PROXY_COOKIE_SECRET=
# Для http://localhost поставьте false
OAUTH2_PROXY_COOKIE_SECURE=true
# Кому разрешён /workflows и /admin: по одному e-mail в строке (cp deploy/oauth2-proxy/emails.txt.example ...)
OAUTH2_PROXY_EMAILS_FILE=./deploy/oauth2-proxy/emails.txt
# Callback для консоли провайдера: <PUBLIC_BASE_URL>/oauth2/callback
# Локально: PUBLIC_BASE_URL=http://localhost:8081 -> http://localhost:8081/oauth2/callback

# --- Redis ------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0
