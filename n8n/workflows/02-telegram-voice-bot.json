{
  "name": "Transcriber — Telegram голосовой бот",
  "nodes": [
    {
      "parameters": {
        "updates": ["message"],
        "additionalFields": { "download": true }
      },
      "id": "b2000000-0000-4000-8000-000000000001",
      "name": "Telegram Trigger",
      "type": "n8n-nodes-base.telegramTrigger",
      "typeVersion": 1.2,
      "position": [-460, 300],
      "webhookId": "transcriber-tg-bot",
      "credentials": { "telegramApi": { "id": "SET_ME", "name": "Transcriber Bot" } },
      "notes": "Подключите credential Telegram API с токеном бота. download:true скачивает voice/audio/video как binary."
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "version": 2 },
          "combinator": "or",
          "conditions": [
            {
              "id": "has-voice",
              "operator": { "type": "object", "operation": "exists", "singleValue": true },
              "leftValue": "={{ $json.message.voice }}"
            },
            {
              "id": "has-audio",
              "operator": { "type": "object", "operation": "exists", "singleValue": true },
              "leftValue": "={{ $json.message.audio }}"
            },
            {
              "id": "has-video-note",
              "operator": { "type": "object", "operation": "exists", "singleValue": true },
              "leftValue": "={{ $json.message.video_note }}"
            },
            {
              "id": "has-document",
              "operator": { "type": "object", "operation": "exists", "singleValue": true },
              "leftValue": "={{ $json.message.document }}"
            }
          ]
        },
        "options": {}
      },
      "id": "b2000000-0000-4000-8000-000000000002",
      "name": "Это медиа?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [-240, 300]
    },
    {
      "parameters": {
        "jsCode": "// Достаём chat_id, режим обработки из подписи и имя бинарного поля.\nconst item = $input.first();\nconst msg = item.json.message;\nconst caption = (msg.caption || '').toLowerCase();\n\n// Управление подписью к сообщению: #summary #minutes #bullets, иначе только текст\nlet post_action = 'none';\nif (caption.includes('#summary') || caption.includes('#кратко')) post_action = 'summary';\nelse if (caption.includes('#minutes') || caption.includes('#протокол')) post_action = 'minutes';\nelse if (caption.includes('#bullets') || caption.includes('#конспект')) post_action = 'bullets';\n\nconst binaryKeys = Object.keys(item.binary || {});\nif (!binaryKeys.length) throw new Error('Telegram не передал файл — включите download в триггере');\n\nreturn [{\n  json: {\n    chat_id: msg.chat.id,\n    message_id: msg.message_id,\n    file_key: binaryKeys[0],\n    filename: item.binary[binaryKeys[0]].fileName || 'voice.ogg',\n    post_action,\n    language: $env.DEFAULT_LANGUAGE || 'ru'\n  },\n  binary: item.binary\n}];"
      },
      "id": "b2000000-0000-4000-8000-000000000003",
      "name": "Подготовка",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-20, 220]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.ASR_BASE_URL || 'http://asr:8000/v1').replace(/\\/$/, '') }}/audio/transcriptions",
        "sendBody": true,
        "contentType": "multipart-form-data",
        "bodyParameters": {
          "parameters": [
            {
              "parameterType": "formBinaryData",
              "name": "file",
              "inputDataFieldName": "={{ $json.file_key }}"
            },
            { "name": "model", "value": "={{ $env.WHISPER__MODEL || 'Systran/faster-whisper-small' }}" },
            { "name": "response_format", "value": "json" },
            { "name": "language", "value": "={{ $json.language }}" }
          ]
        },
        "options": { "timeout": 900000 }
      },
      "id": "b2000000-0000-4000-8000-000000000004",
      "name": "Whisper — распознавание",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [200, 220]
    },
    {
      "parameters": {
        "conditions": {
          "options": { "caseSensitive": true, "version": 2 },
          "combinator": "and",
          "conditions": [
            {
              "id": "need-llm",
              "operator": { "type": "string", "operation": "notEquals" },
              "leftValue": "={{ $('Подготовка').first().json.post_action }}",
              "rightValue": "none"
            }
          ]
        },
        "options": {}
      },
      "id": "b2000000-0000-4000-8000-000000000005",
      "name": "Нужна постобработка?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [420, 220]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ ($env.LLM_BASE_URL || 'http://ollama:11434/v1').replace(/\\/$/, '') }}/chat/completions",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            { "name": "Authorization", "value": "=Bearer {{ $env.LLM_API_KEY || 'ollama' }}" }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ model: $env.LLM_MODEL || 'qwen2.5:7b-instruct', temperature: 0.2, stream: false, messages: [ { role: 'system', content: 'Ты — редактор расшифровок. Не выдумывай фактов, отвечай на языке исходного текста.' }, { role: 'user', content: ({ summary: 'Кратко изложи суть.', minutes: 'Составь протокол: вопросы, решения, задачи со сроками.', bullets: 'Сделай структурированный конспект списками.' }[$('Подготовка').first().json.post_action] || 'Кратко изложи суть.') + '\\n\\nРАСШИФРОВКА:\\n' + $json.text } ] }) }}",
        "options": { "timeout": 600000 }
      },
      "id": "b2000000-0000-4000-8000-000000000006",
      "name": "LLM — постобработка",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [640, 120]
    },
    {
      "parameters": {
        "jsCode": "// Готовим текст ответа: если была постобработка — отдаём и её, и расшифровку.\nconst prep = $('Подготовка').first().json;\nconst asr = $('Whisper — распознавание').first().json;\nconst incoming = $input.first().json;\n\nlet body = (asr.text || '').trim() || '(речь не распознана)';\nif (incoming && incoming.choices && incoming.choices.length) {\n  body = incoming.choices[0].message.content.trim() + '\\n\\n— — —\\nПолная расшифровка:\\n' + body;\n}\n\nreturn [{ json: { chat_id: prep.chat_id, message_id: prep.message_id, text: body.slice(0, 4000) } }];"
      },
      "id": "b2000000-0000-4000-8000-000000000007",
      "name": "Сборка ответа",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [860, 220]
    },
    {
      "parameters": {
        "chatId": "={{ $json.chat_id }}",
        "text": "={{ $json.text }}",
        "additionalFields": { "reply_to_message_id": "={{ $json.message_id }}", "appendAttribution": false }
      },
      "id": "b2000000-0000-4000-8000-000000000008",
      "name": "Ответ в Telegram",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1080, 220],
      "credentials": { "telegramApi": { "id": "SET_ME", "name": "Transcriber Bot" } }
    }
  ],
  "connections": {
    "Telegram Trigger": { "main": [[{ "node": "Это медиа?", "type": "main", "index": 0 }]] },
    "Это медиа?": { "main": [[{ "node": "Подготовка", "type": "main", "index": 0 }], []] },
    "Подготовка": { "main": [[{ "node": "Whisper — распознавание", "type": "main", "index": 0 }]] },
    "Whisper — распознавание": { "main": [[{ "node": "Нужна постобработка?", "type": "main", "index": 0 }]] },
    "Нужна постобработка?": {
      "main": [
        [{ "node": "LLM — постобработка", "type": "main", "index": 0 }],
        [{ "node": "Сборка ответа", "type": "main", "index": 0 }]
      ]
    },
    "LLM — постобработка": { "main": [[{ "node": "Сборка ответа", "type": "main", "index": 0 }]] },
    "Сборка ответа": { "main": [[{ "node": "Ответ в Telegram", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1", "timezone": "Europe/Moscow" },
  "pinData": {},
  "tags": []
}
