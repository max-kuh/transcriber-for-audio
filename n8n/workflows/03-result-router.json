{
  "name": "Transcriber — маршрутизация готового результата",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "transcriber-result",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "c3000000-0000-4000-8000-000000000001",
      "name": "Webhook — готовый результат",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [-460, 300],
      "webhookId": "transcriber-result",
      "notes": "Сюда backend шлёт JSON, когда в задаче выбрано назначение «n8n» (PIPELINE_MODE=direct)."
    },
    {
      "parameters": {
        "jsCode": "// Нормализуем полезную нагрузку и вычисляем маршрут из meta.route.\nconst body = $input.first().json.body ?? $input.first().json;\nconst headers = $input.first().json.headers ?? {};\n\nconst expected = $env.N8N_WEBHOOK_TOKEN || '';\nif (expected && headers['x-transcriber-token'] !== expected) {\n  throw new Error('Неверный X-Transcriber-Token');\n}\n\nconst meta = body.meta || {};\nreturn [{ json: {\n  job_id: body.job_id,\n  filename: body.filename,\n  text: body.text || '',\n  post_output: body.post_output || null,\n  best: body.post_output || body.text || '',\n  route: meta.route || 'archive',\n  meta\n} }];"
      },
      "id": "c3000000-0000-4000-8000-000000000002",
      "name": "Нормализация",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [-240, 300]
    },
    {
      "parameters": {
        "rules": {
          "values": [
            { "conditions": { "options": { "caseSensitive": true, "version": 2 }, "combinator": "and", "conditions": [{ "id": "r1", "operator": { "type": "string", "operation": "equals" }, "leftValue": "={{ $json.route }}", "rightValue": "telegram" }] }, "outputKey": "telegram" },
            { "conditions": { "options": { "caseSensitive": true, "version": 2 }, "combinator": "and", "conditions": [{ "id": "r2", "operator": { "type": "string", "operation": "equals" }, "leftValue": "={{ $json.route }}", "rightValue": "crm" }] }, "outputKey": "crm" },
            { "conditions": { "options": { "caseSensitive": true, "version": 2 }, "combinator": "and", "conditions": [{ "id": "r3", "operator": { "type": "string", "operation": "equals" }, "leftValue": "={{ $json.route }}", "rightValue": "archive" }] }, "outputKey": "archive" }
          ]
        },
        "options": { "fallbackOutput": "extra" }
      },
      "id": "c3000000-0000-4000-8000-000000000003",
      "name": "Куда отправить",
      "type": "n8n-nodes-base.switch",
      "typeVersion": 3.2,
      "position": [-20, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://api.telegram.org/bot{{ $env.TELEGRAM_BOT_TOKEN }}/sendMessage",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ chat_id: $json.meta.chat_id || $env.TELEGRAM_CHAT_ID, text: ('🎙 ' + $json.filename + '\\n\\n' + $json.best).slice(0, 4000) }) }}",
        "options": {}
      },
      "id": "c3000000-0000-4000-8000-000000000004",
      "name": "Telegram",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 100]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.meta.crm_url || $env.OUTBOUND_WEBHOOK_URL }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ external_id: $json.job_id, title: $json.filename, body: $json.best, raw_text: $json.text }) }}",
        "options": {}
      },
      "id": "c3000000-0000-4000-8000-000000000005",
      "name": "CRM / внешняя система",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [240, 280]
    },
    {
      "parameters": {
        "operation": "toText",
        "sourceProperty": "best",
        "binaryPropertyName": "data",
        "options": { "fileName": "={{ $json.job_id }}.txt" }
      },
      "id": "c3000000-0000-4000-8000-000000000006",
      "name": "В текстовый файл",
      "type": "n8n-nodes-base.convertToFile",
      "typeVersion": 1.1,
      "position": [240, 460]
    },
    {
      "parameters": {
        "operation": "write",
        "fileName": "=/data/jobs/{{ $('Нормализация').first().json.job_id }}.txt",
        "dataPropertyName": "data",
        "options": {}
      },
      "id": "c3000000-0000-4000-8000-000000000007",
      "name": "Архив на диск",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1,
      "position": [460, 460]
    }
  ],
  "connections": {
    "Webhook — готовый результат": { "main": [[{ "node": "Нормализация", "type": "main", "index": 0 }]] },
    "Нормализация": { "main": [[{ "node": "Куда отправить", "type": "main", "index": 0 }]] },
    "Куда отправить": {
      "main": [
        [{ "node": "Telegram", "type": "main", "index": 0 }],
        [{ "node": "CRM / внешняя система", "type": "main", "index": 0 }],
        [{ "node": "В текстовый файл", "type": "main", "index": 0 }],
        [{ "node": "В текстовый файл", "type": "main", "index": 0 }]
      ]
    },
    "В текстовый файл": { "main": [[{ "node": "Архив на диск", "type": "main", "index": 0 }]] }
  },
  "settings": { "executionOrder": "v1", "timezone": "Europe/Moscow" },
  "pinData": {},
  "tags": []
}
